{
  "version": "0.2.0",
  "canvas": {
    "width": 600,
    "height": 600
  },
  "allowedBrushMethods": [
    "scaleBrushes",
    "noStroke",
    "fill",
    "noFill",
    "fillBleed",
    "fillTexture",
    "beginShape",
    "vertex",
    "endShape",
    "circle"
  ],
  "bannedIdentifiers": [
    "eval",
    "Function",
    "import",
    "require",
    "fetch",
    "XMLHttpRequest",
    "window",
    "document",
    "globalThis",
    "parent",
    "top",
    "localStorage",
    "sessionStorage",
    "indexedDB",
    "WebSocket",
    "Worker",
    "postMessage",
    "loadImage",
    "loadJSON",
    "loadStrings",
    "text",
    "textSize",
    "textFont",
    "drawingContext",
    "setTimeout",
    "setInterval",
    "Date"
  ],
  "limits": {
    "maxSourceChars": 20000,
    "renderTimeoutMs": 15000,
    "minCoverage": 0.04,
    "maxCoverage": 1.01,
    "minShapes": 3,
    "maxShapes": 400,
    "minDistinctHues": 1
  },
  "render": {
    "pixelDensity": 1,
    "seedRange": 1000000,
    "stableTicks": 3,
    "settleIntervalMs": 40
  },
  "reward": {
    "weights": {
      "gate": 0.05,
      "length": 0.05,
      "hpsv3": 0.3,
      "pairwise": 0.6,
      "taste": 0.6
    },
    "pairwise": {
      "referencesPerRollout": 2,
      "tier": "love",
      "bothOrders": true
    },
    "length": {
      "mode": "binary",
      "minChars": 400,
      "maxChars": 12000
    }
  },
  "sketchMode": "full",
  "allowedP5Globals": [
    "createCanvas",
    "background",
    "translate",
    "angleMode",
    "noLoop",
    "push",
    "pop",
    "rotate",
    "scale",
    "random",
    "noise",
    "randomSeed",
    "noiseSeed",
    "width",
    "height",
    "WEBGL",
    "DEGREES",
    "RADIANS",
    "PI",
    "TWO_PI",
    "HALF_PI",
    "setup",
    "draw",
    "pixelDensity",
    "color",
    "lerpColor",
    "map",
    "constrain",
    "dist",
    "sin",
    "cos",
    "atan2",
    "sqrt",
    "abs",
    "floor",
    "ceil",
    "round",
    "min",
    "max",
    "frameRate"
  ]
}